# ---- Application ----
ENVIRONMENT=local
# DEBUG switches logs to human-readable console output and exposes /docs.
DEBUG=true
# SQL_ECHO logs every SQL statement. Very noisy — turn on only when debugging queries.
SQL_ECHO=false
PROJECT_NAME=Implesia Backend
API_V1_PREFIX=/api/v1

# Comma separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,https://implesia.com,https://www.implesia.com

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
# docker compose publishes Postgres on 5433 to avoid clashing with a Postgres
# already installed on the host. The api container overrides this to 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=implesia
POSTGRES_PASSWORD=implesia
POSTGRES_DB=implesia

# ---- Redis ----
# docker compose publishes Redis on 6380 for the same reason.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LEADS=5/hour
RATE_LIMIT_ORDERS=5/hour

# ---- Bootstrap superuser (used by scripts/create_superuser.py) ----
FIRST_SUPERUSER_EMAIL=admin@implesia.com
FIRST_SUPERUSER_PASSWORD=change-me-too

# ---- Email (optional, free Gmail SMTP — no paid provider) ----
# Leave SMTP_HOST empty to only log emails. Orders still save to the admin inbox.
# To actually land in Gmail: Google Account → Security → App passwords (free).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=implesiaitltd@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=implesiaitltd@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=implesiaitltd@gmail.com
EMAIL_FROM_NAME=Implesia IT
LEAD_NOTIFICATION_RECIPIENTS=implesiaitltd@gmail.com

# ---- Cloudflare Turnstile (leave empty to disable verification) ----
TURNSTILE_SECRET_KEY=
