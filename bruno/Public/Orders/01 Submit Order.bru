meta {
  name: Submit Order
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/orders
  body: json
  auth: none
}

headers {
  Idempotency-Key: bruno-order-001
}

body:json {
  {
    "service_id": "{{SERVICE_ID}}",
    "full_name": "Jonathan Reid",
    "email": "j.reid@acme.com",
    "phone": "+44 20 7946 0000",
    "organisation": "Acme Corporation",
    "message": "We want to start with this service next month. Please send a commercial path.",
    "source_page": "/services/saas-architecture"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body.id) {
    bru.setEnvVar("ORDER_ID", body.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
