meta {
  name: Submit Lead
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/leads
  body: json
  auth: none
}

headers {
  Idempotency-Key: bruno-lead-001
}

body:json {
  {
    "full_name": "Jonathan Reid",
    "email": "j.reid@acme.com",
    "phone": "+44 20 7946 0000",
    "organisation": "Acme Corporation",
    "service_area": "saas-architecture",
    "timeline": "1-3-months",
    "brief": "We need to modernise a legacy monolith into a cloud-native platform for our product team.",
    "source_page": "/contact"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body.id) {
    bru.setEnvVar("LEAD_ID", body.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
