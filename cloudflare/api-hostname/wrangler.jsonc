{
  "$schema": "https://unpkg.com/wrangler@4.115.0/config-schema.json",
  "name": "implesia-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "api.implesia.com",
      "custom_domain": true
    }
  ],
  "vars": {
    // Set this to the FastAPI origin after you host it, e.g. https://implesia-api.onrender.com
    "ORIGIN": ""
  }
}
